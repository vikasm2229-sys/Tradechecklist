<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>My Terminal Pro</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#0d1218;color:#e6ecf3;font:13px system-ui,-apple-system,"Segoe UI",sans-serif}
.app{display:grid;grid-template-columns:44px 1fr 290px;grid-template-rows:auto 1fr auto;height:100%}
.top{grid-column:1/4;display:flex;gap:8px;align-items:center;padding:6px 10px;background:#141b24;border-bottom:1px solid #232d3a;flex-wrap:wrap}
.top b{font-size:15px;margin-right:4px}
input,select,button,textarea{background:#0d1218;color:#e6ecf3;border:1px solid #2c3948;border-radius:5px;padding:4px 8px;font:inherit}
button{cursor:pointer}
button.on{background:#2563eb;border-color:#2563eb}
button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid #5b8cff}
.tfs{display:flex;gap:2px}.tfs button{border-color:transparent;background:none;color:#8493a6;padding:4px 7px}
.tfs button.on{background:#232d3a;color:#e6ecf3}
.chk{display:flex;gap:3px;align-items:center;color:#8493a6}
.chk input{padding:0}
#ohlc{color:#8493a6;margin-left:auto}
.tools{background:#141b24;border-right:1px solid #232d3a;display:flex;flex-direction:column;gap:4px;padding:6px 4px}
.tools button{padding:6px 0;font-size:14px;border-color:transparent;background:none}
.tools button.on{background:#2563eb}
.cw{position:relative;min-width:0;min-height:0}
#chart,#ov{position:absolute;inset:0;width:100%;height:100%}
#ov{pointer-events:none}
#ov.act{pointer-events:auto;cursor:crosshair}
.side{display:flex;flex-direction:column;background:#141b24;border-left:1px solid #232d3a;min-height:0}
.side h3{margin:0;padding:8px 12px 4px;font-size:12px;color:#8493a6;font-weight:500}
#wl{overflow:auto;max-height:42%;flex:none}
.row{display:flex;justify-content:space-between;width:100%;padding:7px 12px;border:0;border-left:3px solid transparent;border-radius:0;background:none;text-align:left}
.row:hover{background:#0d1218}.row.on{background:#0d1218;border-left-color:#2563eb}
.row span{font-variant-numeric:tabular-nums}
.u{color:#2ebd85}.d{color:#f0616d}
.opts{padding:4px 12px;display:grid;gap:4px;color:#8493a6}
.opts label{display:flex;justify-content:space-between;align-items:center}
#code{flex:1;margin:6px 12px;font:12px/1.5 ui-monospace,Menlo,Consolas,monospace;resize:none;white-space:pre;min-height:120px}
.act{display:flex;gap:6px;padding:0 12px 6px}
.act button:first-child{background:#2563eb;border-color:#2563eb}
#log{padding:0 12px 8px;color:#f0616d;font-size:12px;min-height:18px}
.foot{grid-column:1/4;padding:4px 10px;color:#8493a6;font-size:11px;border-top:1px solid #232d3a;background:#141b24}
.foot a{color:#8493a6}
@media(max-width:820px){
.app{grid-template-columns:1fr;grid-template-rows:auto auto 56vh auto auto;height:auto;min-height:100%}
.top,.foot{grid-column:1}
.tools{flex-direction:row;border-right:0;border-bottom:1px solid #232d3a;overflow-x:auto}
.tools button{padding:6px 12px}
.side{border-left:0}#wl{max-height:none}
#ohlc{margin-left:0}
}
</style>
</head>
<body>
<div class="app">
  <div class="top">
    <b>My Terminal</b>
    <input id="sym" value="BTCUSDT" size="9" aria-label="Symbol">
    <div class="tfs" id="tfs"></div>
    <select id="style" aria-label="Chart style">
      <option value="candles">Candles</option><option value="ha">Heikin Ashi</option>
      <option value="line">Line</option><option value="area">Area</option>
    </select>
    <label class="chk"><input type="checkbox" id="i_sma">SMA 20</label>
    <label class="chk"><input type="checkbox" id="i_ema">EMA 50</label>
    <label class="chk"><input type="checkbox" id="i_bb">Bollinger</label>
    <label class="chk"><input type="checkbox" id="i_vol" checked>Volume</label>
    <span id="ohlc"></span>
  </div>
  <div class="tools" id="tools"></div>
  <div class="cw"><div id="chart"></div><canvas id="ov"></canvas></div>
  <div class="side">
    <h3>Watchlist</h3>
    <div id="wl"></div>
    <h3>Indicator script (JavaScript)</h3>
    <div class="opts">
      <label>Apply to day open only <input type="checkbox" id="p_day"></label>
      <label>Hour threshold <input type="number" id="p_thr" value="6" style="width:60px"></label>
      <label>Show price line <input type="checkbox" id="p_line" checked></label>
      <label>Hide ticker candles <input type="checkbox" id="hide" checked></label>
    </div>
    <textarea id="code" spellcheck="false"></textarea>
    <div class="act"><button id="add">Add to chart</button><button id="rem">Remove</button></div>
    <div id="log"></div>
  </div>
  <div class="foot">Charts by <a href="https://www.tradingview.com/" target="_blank" rel="noopener">TradingView Lightweight Charts™</a> (Apache 2.0). Prices from Binance. Not financial advice.</div>
</div>
<script src="https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>
<script>
(function(){
var $=function(i){return document.getElementById(i)};
var PAIRS=["BTCUSDT","ETHUSDT","BNBUSDT","SOLUSDT","XRPUSDT","DOGEUSDT","ADAUSDT","AVAXUSDT","LINKUSDT","TRXUSDT"];
var TFS=["1m","5m","15m","1h","4h","1d"];
var FIB=[0,.236,.382,.5,.618,.786,1];
var DEFAULT="// No gaps candles (ported from Pine Script)\n// bars = [{time, open, high, low, close, volume}], params = {dayOpenOnly, threshold, showLine}\n// Return { candles: [...], priceLine: true } or { line: [{time, value}] }\nconst out = bars.map((b, i) => {\n  let o = b.open;\n  const hours = i > 0 ? (b.time - bars[i - 1].time) / 3600 : 0;\n  if (i > 0 && (!params.dayOpenOnly || hours > params.threshold)) {\n    o = bars[i - 1].close;\n  }\n  return { time: b.time, open: o, high: b.high, low: b.low, close: b.close };\n});\nreturn { candles: out, priceLine: params.showLine };";
var S={sym:"BTCUSDT",tf:"1h",style:"candles",ng:false,tool:"cur"};
var IND={sma:false,ema:false,bb:false,vol:true};
var UP="#2ebd85",DN="#f0616d",TEAL="#089981",RED="#f23645";
var bars=[],main=null,ser={},ws=null,draws=[],tmp=null,raf=0,ngT=null,ngPL=null;
$("code").value=DEFAULT;

var chart=LightweightCharts.createChart($("chart"),{
  autoSize:true,
  layout:{background:{color:"#0d1218"},textColor:"#8493a6"},
  grid:{vertLines:{color:"#1a232e"},horzLines:{color:"#1a232e"}},
  timeScale:{timeVisible:true,borderColor:"#232d3a"},rightPriceScale:{borderColor:"#232d3a"}
});
function log(m){$("log").textContent=m||""}
function params(){return{dayOpenOnly:$("p_day").checked,threshold:+$("p_thr").value||0,showLine:$("p_line").checked}}

/* ---------- series helpers ---------- */
function mkMain(){
  if(main)chart.removeSeries(main);
  if(S.style==="line")main=chart.addLineSeries({color:"#5b8cff",lineWidth:2});
  else if(S.style==="area")main=chart.addAreaSeries({lineColor:"#5b8cff",topColor:"rgba(91,140,255,.35)",bottomColor:"rgba(91,140,255,0)"});
  else main=chart.addCandlestickSeries({upColor:UP,downColor:DN,borderVisible:false,wickUpColor:UP,wickDownColor:DN});
}
function disp(){
  if(S.style==="ha"){var out=[];bars.forEach(function(b,i){var c=(b.open+b.high+b.low+b.close)/4,o=i?(out[i-1].open+out[i-1].close)/2:(b.open+b.close)/2;out.push({time:b.time,open:o,close:c,high:Math.max(b.high,o,c),low:Math.min(b.low,o,c)})});return out}
  if(S.style==="line"||S.style==="area")return bars.map(function(b){return{time:b.time,value:b.close}});
  return bars;
}
function rm(k){if(ser[k]){chart.removeSeries(ser[k]);delete ser[k]}if(k==="ng"){ngT=null;ngPL=null}}
function ln(k,col,data){
  if(!data){rm(k);return}
  if(!ser[k])ser[k]=chart.addLineSeries({color:col,lineWidth:1,priceLineVisible:false,lastValueVisible:false,crosshairMarkerVisible:false});
  ser[k].setData(data);
}
function sma(n){var o=[],s=0;bars.forEach(function(b,i){s+=b.close;if(i>=n)s-=bars[i-n].close;if(i>=n-1)o.push({time:b.time,value:s/n})});return o}
function ema(n){var o=[],k=2/(n+1),e;bars.forEach(function(b,i){e=i?b.close*k+e*(1-k):b.close;if(i>=n-1)o.push({time:b.time,value:e})});return o}
function bb(n,m){
  var u=[],mi=[],l=[];
  bars.forEach(function(b,i){
    if(i<n-1)return;
    var s=0,v=0,j;
    for(j=i-n+1;j<=i;j++)s+=bars[j].close;
    var a=s/n;
    for(j=i-n+1;j<=i;j++)v+=Math.pow(bars[j].close-a,2);
    var d=Math.sqrt(v/n)*m;
    u.push({time:b.time,value:a+d});mi.push({time:b.time,value:a});l.push({time:b.time,value:a-d});
  });
  return[u,mi,l];
}
function vol(){
  if(!IND.vol){rm("vol");return}
  if(!ser.vol){
    ser.vol=chart.addHistogramSeries({priceFormat:{type:"volume"},priceScaleId:"v",lastValueVisible:false,priceLineVisible:false});
    chart.priceScale("v").applyOptions({scaleMargins:{top:.85,bottom:0}});
  }
  ser.vol.setData(bars.map(function(b){return{time:b.time,value:b.volume,color:b.close>=b.open?"#2ebd8566":"#f0616d66"}}));
}

/* ---------- No Gap Candles / script runner ---------- */
function runScript(){
  log("");
  if(!S.ng){rm("ng");return}
  var res;
  try{res=new Function("bars","params",$("code").value)(bars.map(function(b){return Object.assign({},b)}),params())}
  catch(e){log("Script error: "+e.message);return}
  if(res&&res.candles){
    if(ngT!=="c"){rm("ng");ngT="c";ser.ng=chart.addCandlestickSeries({upColor:TEAL,downColor:RED,borderUpColor:TEAL,borderDownColor:RED,wickUpColor:TEAL,wickDownColor:RED,priceLineVisible:false,lastValueVisible:false})}
    ser.ng.setData(res.candles);
    if(ngPL){ser.ng.removePriceLine(ngPL);ngPL=null}
    var l=res.candles[res.candles.length-1];
    if(res.priceLine&&l)ngPL=ser.ng.createPriceLine({price:l.close,color:l.close>=l.open?TEAL:RED,lineWidth:1,lineStyle:1,axisLabelVisible:true,title:""});
  }else if(res&&res.line){
    if(ngT!=="l"){rm("ng");ngT="l";ser.ng=chart.addLineSeries({color:"#f0b429",lineWidth:2,priceLineVisible:false})}
    ser.ng.setData(res.line);
  }else log("Script must return { candles } or { line }.");
}
function hideMain(){main.applyOptions({visible:!($("hide").checked&&S.ng&&!!ser.ng)})}

function render(){
  if(!bars.length)return;
  main.setData(disp());
  ln("sma","#f0b429",IND.sma?sma(20):0);
  ln("ema","#5b8cff",IND.ema?ema(50):0);
  var B=IND.bb?bb(20,2):[0,0,0];
  ln("bbu","#a78bfa",B[0]);ln("bbm","#a78bfa88",B[1]);ln("bbl","#a78bfa",B[2]);
  vol();runScript();hideMain();
}
function sched(){if(!raf)raf=requestAnimationFrame(function(){raf=0;render()})}

/* ---------- data ---------- */
var BASES=["https://api.binance.com","https://data-api.binance.vision"];
function get(path,i){
  return fetch(BASES[i]+path).then(function(r){if(!r.ok)throw new Error("bad");return r.json()})
    .catch(function(e){if(i+1<BASES.length)return get(path,i+1);throw e});
}
function load(){
  if(ws){ws.onmessage=null;ws.close();ws=null}
  var s=S.sym,tf=S.tf;log("");
  get("/api/v3/klines?symbol="+s+"&interval="+tf+"&limit=1000",0).then(function(rows){
    if(s!==S.sym||tf!==S.tf)return;
    bars=rows.map(function(k){return{time:Math.floor(k[0]/1000),open:+k[1],high:+k[2],low:+k[3],close:+k[4],volume:+k[5]}});
    render();chart.timeScale().fitContent();
    ws=new WebSocket("wss://stream.binance.com:9443/ws/"+s.toLowerCase()+"@kline_"+tf);
    ws.onmessage=function(ev){
      var k=JSON.parse(ev.data).k,b={time:Math.floor(k.t/1000),open:+k.o,high:+k.h,low:+k.l,close:+k.c,volume:+k.v},l=bars[bars.length-1];
      if(l&&l.time===b.time)bars[bars.length-1]=b;else bars.push(b);
      sched();
    };
  }).catch(function(){log("Could not load "+s+". Check the symbol or your connection.")});
  Array.prototype.forEach.call($("wl").children,function(r){r.className="row"+(r.dataset.s===s?" on":"")});
}
chart.subscribeCrosshairMove(function(p){
  var d=p.seriesData&&p.seriesData.get(main);
  $("ohlc").textContent=!d?"":("open" in d)?"O "+d.open.toFixed(2)+"  H "+d.high.toFixed(2)+"  L "+d.low.toFixed(2)+"  C "+d.close.toFixed(2):"Price "+d.value.toFixed(2);
});

/* ---------- drawing tools ---------- */
var cv=$("ov"),cx=cv.getContext("2d"),TOOLS=[["cur","↖","Cursor"],["t","╱","Trendline"],["h","─","Horizontal line"],["r","▭","Rectangle"],["f","Fib","Fibonacci retracement"],["x","✕","Clear drawings"]];
function setTool(t){
  S.tool=t;cv.className=t==="cur"?"":"act";
  Array.prototype.forEach.call($("tools").children,function(b){b.className=b.dataset.t===t?"on":""});
}
TOOLS.forEach(function(t){
  var b=document.createElement("button");b.textContent=t[1];b.title=t[2];b.setAttribute("aria-label",t[2]);b.dataset.t=t[0];
  b.onclick=function(){if(t[0]==="x"){draws=[];setTool("cur")}else setTool(t[0])};
  $("tools").appendChild(b);
});
function pt(e){
  var r=cv.getBoundingClientRect(),t=chart.timeScale().coordinateToTime(e.clientX-r.left),p=main.coordinateToPrice(e.clientY-r.top);
  return t==null||p==null?null:{t:t,p:p};
}
cv.onpointerdown=function(e){
  var q=pt(e);if(!q)return;
  if(S.tool==="h"){draws.push({k:"h",a:q});setTool("cur");return}
  tmp={k:S.tool,a:q,b:q};cv.setPointerCapture(e.pointerId);
};
cv.onpointermove=function(e){if(tmp){var q=pt(e);if(q)tmp.b=q}};
cv.onpointerup=function(){if(tmp){draws.push(tmp);tmp=null;setTool("cur")}};
function xy(p){return{x:chart.timeScale().timeToCoordinate(p.t),y:main.priceToCoordinate(p.p)}}
function seg(x1,y1,x2,y2){cx.beginPath();cx.moveTo(x1,y1);cx.lineTo(x2,y2);cx.stroke()}
function paint(){
  var dpr=window.devicePixelRatio||1,w=cv.clientWidth,h=cv.clientHeight;
  if(cv.width!==Math.round(w*dpr)||cv.height!==Math.round(h*dpr)){cv.width=Math.round(w*dpr);cv.height=Math.round(h*dpr)}
  cx.setTransform(dpr,0,0,dpr,0,0);cx.clearRect(0,0,w,h);
  cx.strokeStyle="#f0b429";cx.fillStyle="#f0b429";cx.lineWidth=1.5;cx.font="11px system-ui,sans-serif";
  draws.concat(tmp?[tmp]:[]).forEach(function(d){
    var a=xy(d.a),b=d.b?xy(d.b):null;
    if(a.y==null)return;
    if(d.k==="h"){seg(0,a.y,w,a.y);cx.fillText(d.a.p.toFixed(2),6,a.y-4);return}
    if(a.x==null||!b||b.x==null||b.y==null)return;
    if(d.k==="t")seg(a.x,a.y,b.x,b.y);
    else if(d.k==="r"){cx.globalAlpha=.12;cx.fillRect(a.x,a.y,b.x-a.x,b.y-a.y);cx.globalAlpha=1;cx.strokeRect(a.x,a.y,b.x-a.x,b.y-a.y)}
    else if(d.k==="f"){
      var x0=Math.min(a.x,b.x);
      FIB.forEach(function(lv){
        var p=d.b.p+(d.a.p-d.b.p)*lv,y=main.priceToCoordinate(p);
        if(y==null)return;
        cx.globalAlpha=.8;seg(x0,y,w,y);cx.globalAlpha=1;cx.fillText(lv+"  ("+p.toFixed(2)+")",x0+4,y-3);
      });
    }
  });
  requestAnimationFrame(paint);
}

/* ---------- UI wiring ---------- */
TFS.forEach(function(t){
  var b=document.createElement("button");b.textContent=t;b.className=t===S.tf?"on":"";
  b.onclick=function(){S.tf=t;Array.prototype.forEach.call($("tfs").children,function(x){x.className=x.textContent===t?"on":""});load()};
  $("tfs").appendChild(b);
});
$("sym").onkeydown=function(e){if(e.key==="Enter"){S.sym=this.value.trim().toUpperCase();load()}};
$("style").onchange=function(){S.style=this.value;mkMain();render()};
[["i_sma","sma"],["i_ema","ema"],["i_bb","bb"],["i_vol","vol"]].forEach(function(x){$(x[0]).onchange=function(){IND[x[1]]=this.checked;render()}});
$("add").onclick=function(){S.ng=true;render()};
$("rem").onclick=function(){S.ng=false;rm("ng");hideMain();log("")};
["p_day","p_thr","p_line","hide"].forEach(function(id){$(id).onchange=render});

/* watchlist */
function fp(p){return p>=100?p.toFixed(2):p>=1?p.toFixed(4):p.toFixed(6)}
PAIRS.forEach(function(p){
  var b=document.createElement("button");b.className="row";b.dataset.s=p;
  b.innerHTML="<span>"+p.replace("USDT","")+"<small style='color:#8493a6'>/USDT</small></span><span id='w_"+p+"'>–</span>";
  b.onclick=function(){S.sym=p;$("sym").value=p;load()};
  $("wl").appendChild(b);
});
try{
  var wlws=new WebSocket("wss://stream.binance.com:9443/stream?streams="+PAIRS.map(function(p){return p.toLowerCase()+"@miniTicker"}).join("/"));
  wlws.onmessage=function(e){
    var d=JSON.parse(e.data).data,el=$("w_"+d.s);if(!el)return;
    var c=+d.c,ch=(c/+d.o-1)*100;
    el.className=ch>=0?"u":"d";el.textContent=fp(c)+"  "+(ch>=0?"+":"")+ch.toFixed(2)+"%";
  };
}catch(e){}

mkMain();load();paint();
})();
</script>
</body>
</html>
